# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# --- Statuspage --------------------------------------------------------

# Required. Statuspage API key (OAuth token) with write access to the page
# below. Generate one from your Statuspage account: My Profile > API Info.
STATUSPAGE_API_KEY=

# Required. ID of the Statuspage page the bridge manages incidents on.
# Found in Statuspage under Pages, or in the page's dashboard URL
# (https://manage.statuspage.io/pages/<STATUSPAGE_PAGE_ID>).
STATUSPAGE_PAGE_ID=

# --- Webhook security ----------------------------------------------------

# Required. Shared secret AlertManager must present to call /webhook.
# Generate one with: openssl rand -hex 32
# The bridge refuses to start if this is not set.
SECRET_WEBHOOK=

# --- AlertManager --------------------------------------------------------

# Optional. Base URL of the AlertManager API, used for the periodic
# reconciliation pass (catches alerts resolved without a webhook ever
# being received). Default: http://alertmanager:9093
ALERTMANAGER_URL=http://alertmanager:9093

# Optional. Interval, in seconds, between reconciliation passes.
# Default: 60
ALERTMANAGER_POLL_INTERVAL_SECONDS=60

# --- Bridge ---------------------------------------------------------------

# Optional. Port the bridge listens on. Default: 9090
BRIDGE_PORT=9090

# Optional. Path to the local JSON file used to persist running incidents
# across restarts. When running with docker-compose, this path is mounted
# on a named volume; changing it there requires updating the volume mount
# too. Default: /app/data/incidents_store.json
INCIDENTS_STORE_PATH=/app/data/incidents_store.json

# Optional. Log verbosity: DEBUG, INFO, WARNING, ERROR. DEBUG also logs
# every outgoing HTTP request; INFO is recommended for production.
# Default: INFO
LOG_LEVEL=INFO
